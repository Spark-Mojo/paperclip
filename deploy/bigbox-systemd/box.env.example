# Box-local Paperclip API endpoints for systemd units.
# Units source this via EnvironmentFile= — so the port is per-box, never
# hardcoded in the unit. Install per box:
#   laptop:  cp box.env.example ~/.config/paperclip/box.env   (keep :3100)
#   bigbox:  edit PAPERCLIP_API_URL to this box's shadow-engine port
#            (today :3100, :3101 once the shadow-engine port moves, SPA-6059 subtask 2).
PAPERCLIP_API_URL=http://127.0.0.1:3100
QUESTION_PINGER_PAPERCLIP_URL=http://127.0.0.1:3100
